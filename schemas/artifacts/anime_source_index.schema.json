{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnimeSourceIndex",
  "description": "What one anime episode actually contains — scenes, visible actions and spoken lines with timestamps. Built from real analysis (scene_detect, frame_sampler, transcriber, agent vision) or explicitly marked as mock. It is the only ground truth an anime_recap_plan may cite.",
  "type": "object",
  "required": ["version", "source_index_id", "provenance", "video", "scenes"],
  "properties": {
    "version": { "type": "string" },
    "source_index_id": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["analyzed", "mock"],
          "description": "'analyzed' only when tools really ran on the video file; 'mock' for test or demo data."
        },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools that produced the data, e.g. scene_detect, frame_sampler, transcriber(large-v3, ja)."
        },
        "note": { "type": "string" }
      }
    },
    "video": {
      "type": "object",
      "required": ["path", "fps", "duration_seconds"],
      "properties": {
        "path": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "has_subtitles": { "type": "boolean" }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "name_ja"],
        "properties": {
          "character_id": { "type": "string" },
          "name_ja": { "type": "string" },
          "name_vi": { "type": "string" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "start_seconds", "end_seconds", "visual_summary"],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1 },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "visual_summary": { "type": "string", "description": "What is visible on screen (Japanese). Observation only, no interpretation." },
          "characters": { "type": "array", "items": { "type": "string" } },
          "actions": { "type": "array", "items": { "type": "string" } },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["timestamp_seconds", "path"],
              "properties": {
                "timestamp_seconds": { "type": "number", "minimum": 0 },
                "path": { "type": "string" }
              }
            }
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line_id", "start_seconds", "end_seconds", "text_ja"],
              "properties": {
                "line_id": { "type": "string", "minLength": 1 },
                "start_seconds": { "type": "number", "minimum": 0 },
                "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
                "speaker": { "type": ["string", "null"], "description": "character_id, or null when the speaker is not identified." },
                "text_ja": { "type": "string" },
                "text_vi": { "type": "string" },
                "asr_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
